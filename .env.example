# Supabase → Project Settings → API Keys
NEXT_PUBLIC_SUPABASE_URL=https://twoj-projekt.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Adres strony (lokalnie http://localhost:3000, na produkcji Twoja domena)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# TYLKO do jednorazowego importu uczelni (npm run import:institutions).
# Klucz "secret" z Supabase. NIGDY nie dodawaj go na Vercel ani z przedrostkiem NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# Ustaw na 1 po włączeniu Google w Supabase → Authentication → Providers
NEXT_PUBLIC_GOOGLE_AUTH=
